{
  "version": 2,
  "buildCommand": "cd daily-task-generator && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": " npm install",
  "rewrites": [
    { "source": "/frontend/(.*)", "destination": "/frontend/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "frontend/index.html": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
